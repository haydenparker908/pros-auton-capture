{
  "name": "pros-auton-capture",
  "displayName": "Hayden Robotics PROS Helper",
  "description": "Pinned Quick Actions to build/upload and capture PROS match or skills auton logs into brain-logs/latest.txt.",
  "version": "0.2.3",
  "publisher": "HaydenRobotics",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/haydenparker908/pros-auton-capture.git"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pros",
    "vex",
    "v5",
    "auton",
    "robotics"
  ],
  "activationEvents": [
    "workspaceContains:**/project.pros",
    "onView:haydenProsHelper.actions"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "haydenProsHelper",
          "title": "Hayden Robotics PROS Helper",
          "icon": "media/h.svg"
        }
      ]
    },
    "views": {
      "haydenProsHelper": [
        {
          "id": "haydenProsHelper.actions",
          "name": "Quick Actions",
          "contextualTitle": "Hayden Robotics PROS Helper"
        }
      ]
    },
    "commands": [
      {
        "command": "prosAutonCapture.captureMatch",
        "title": "Capture Match Auton",
        "icon": "$(play)",
        "category": "Hayden Robotics PROS Helper"
      },
      {
        "command": "prosAutonCapture.captureSkills",
        "title": "Capture Skills Auton",
        "icon": "$(rocket)",
        "category": "Hayden Robotics PROS Helper"
      },
      {
        "command": "prosAutonCapture.openLatestLog",
        "title": "Open Latest Brain Log",
        "icon": "$(file-text)",
        "category": "Hayden Robotics PROS Helper"
      },
      {
        "command": "prosAutonCapture.deleteLogs",
        "title": "Delete all log files",
        "icon": "$(trash)",
        "category": "Hayden Robotics PROS Helper"
      },
      {
        "command": "prosAutonCapture.openSettings",
        "title": "Open Settings",
        "icon": "$(gear)",
        "category": "Hayden Robotics PROS Helper"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "prosAutonCapture.isProsProject",
          "command": "prosAutonCapture.captureMatch",
          "group": "navigation@90"
        },
        {
          "when": "prosAutonCapture.isProsProject",
          "command": "prosAutonCapture.captureSkills",
          "group": "navigation@91"
        }
      ],
      "view/title": [
        {
          "command": "prosAutonCapture.openSettings",
          "when": "view == haydenProsHelper.actions",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "prosAutonCapture.captureMatch",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "prosAutonCapture.isProsProject || workspaceFolderCount > 0"
      },
      {
        "command": "prosAutonCapture.captureSkills",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "prosAutonCapture.isProsProject || workspaceFolderCount > 0"
      },
      {
        "command": "prosAutonCapture.deleteLogs",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "prosAutonCapture.isProsProject || workspaceFolderCount > 0"
      }
    ],
    "configuration": {
      "title": "Hayden Robotics PROS Helper",
      "properties": {
        "prosAutonCapture.singleSlotMode": {
          "type": "boolean",
          "default": false,
          "description": "Use one V5 slot for both match and skills uploads (overwrites the same slot)."
        },
        "prosAutonCapture.sharedSlot": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 8,
          "description": "Slot used when Single Slot Mode is on."
        },
        "prosAutonCapture.matchSlot": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 8,
          "description": "V5 slot for match auton (when Single Slot Mode is off)."
        },
        "prosAutonCapture.skillsSlot": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 8,
          "description": "V5 slot for skills auton (when Single Slot Mode is off)."
        },
        "prosAutonCapture.logDir": {
          "type": "string",
          "default": "brain-logs",
          "description": "Folder under the PROS project for captures. Always updates latest.txt plus a timestamped copy."
        },
        "prosAutonCapture.openLatestOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Open brain-logs/latest.txt when a capture starts so you can watch the log."
        },
        "prosAutonCapture.matchStopPattern": {
          "type": "string",
          "default": "[auton] done",
          "description": "Stop match capture when brain output contains this string."
        },
        "prosAutonCapture.skillsStopPattern": {
          "type": "string",
          "default": "[skills] done",
          "description": "Stop skills capture when brain output contains this string."
        },
        "prosAutonCapture.matchBenchButton": {
          "type": "string",
          "default": "X",
          "description": "Controller button shown in the match capture prompt."
        },
        "prosAutonCapture.skillsBenchButton": {
          "type": "string",
          "default": "Y",
          "description": "Controller button shown in the skills capture prompt."
        },
        "prosAutonCapture.timeoutSec": {
          "type": "number",
          "default": 180,
          "description": "Max seconds to wait for the stop pattern."
        },
        "prosAutonCapture.skillsMakeExtra": {
          "type": "string",
          "default": "EXTRA_CXXFLAGS=-DAUTON_SKILLS",
          "description": "Extra make flags for skills builds (empty to skip). Used so slot skills binaries default to skills auton."
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --allow-missing-repository --no-dependencies"
  }
}
